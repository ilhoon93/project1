# ============================================================
# .env.local.example
#
# 이 파일은 Git에 커밋됩니다. 실제 키/시크릿은 절대 여기에 넣지 마세요.
# 사용 방법:
#   1) `cp .env.local.example .env.local`
#   2) `.env.local`을 본인의 값으로 채움 — 이 파일은 .gitignore되어 있어 안전
#   3) 운영 배포(Vercel)에서는 대시보드 환경변수에 동일 키들을 등록
#
# 만약 과거에 실제 키가 이 파일이나 git history에 노출된 적이 있다면,
# Supabase / Kakao / Naver / PortOne / fal.ai 대시보드에서 모두 재발급(rotate)
# 한 뒤 이 파일은 placeholder만 유지하세요.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
# Project URL (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://gjzvnyjzhgycsiapxmlw.supabase.co
# Anon (public) key — RLS 검증 하에 브라우저로 내려감
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — 서버 전용. RLS 우회. 절대 클라이언트 번들에 들어가지 않게.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (Kakao OAuth) ───────────────────────────────────
# Supabase Dashboard → Authentication → Providers → Kakao 에 등록.
# 아래 값은 코드에서 직접 사용하지 않지만 일부 운영 스크립트가 참고할 수 있음.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── Auth (Naver Login) ────────────────────────────────────
# https://developers.naver.com → 애플리케이션 등록 → Naver Login
#   Callback URL: <BASE_URL>/api/auth/naver/callback
#   서비스 환경: PC / 모바일 웹 모두 등록
#   동의 항목(콘솔 설정): 필수 = 이메일 1개만, 회원이름/별명은 선택
#   (식별 키는 Naver 고유 id 라 이름/별명/이메일 동의 여부와 무관하게 식별·주문매칭 정상 동작.
#    이메일이 비어도 가짜 이메일로 폴백 가입, 이름이 비면 display_name 은 이메일 앞부분 사용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Naver Commerce API (스마트스토어 주문 자동 조회) ───────
# https://apicenter.commerce.naver.com → 애플리케이션 등록
# 네이버 로그인과 별도 자격증명. 애플리케이션 등록 시 "주문 판매자" API
# 그룹을 추가해야 주문조회가 동작한다. 미설정 시 /api/orders/register 는
# 503(연동 준비 중)을 돌려준다.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
# 커머스 API 는 "API호출 IP" 화이트리스트가 필수. Vercel 은 고정 출발 IP 가
# 없으므로, 고정 IP VPS 의 정방향 프록시 URL 을 지정하면 커머스 API 호출만
# 그 프록시를 경유해 IP 가 고정된다. 그 프록시의 공인 IP 를 커머스 API 센터의
# "API호출 IP" 에 등록할 것. 예: http://user:pass@1.2.3.4:8888 (미설정 시 직접 호출)
NAVER_COMMERCE_PROXY=

# ── AI (fal.ai) ──────────────────────────────────────────
# https://fal.ai/dashboard/keys
FAL_KEY=

# ── 웨딩스냅 후처리 파이프라인 토글 ─────────────────────
# 각 단계 독립 ON/OFF. 모두 OFF 면 생성 결과 그대로 storage 업로드.
# 비용/효과 트레이드오프는 docs/snap-pipeline.md 참조.
#
# SNAP_HARMONIZE_MODE: 카탈로그 평균 컬러로 톤 매칭 (Phase 1)
#   off    — 비활성
#   global — 마스크 없이 전역 매칭 (사실상 무료, ~0초)
#   masked — birefnet 마스크 기반 분할 매칭 (피부톤 보호, ~$0.003/장, +3~5초) ← 기본
SNAP_HARMONIZE_MODE=masked
#
# SNAP_FINISHING_MODE: flux 저강도 img2img 로 톤/조명 통합 (Phase 2)
#   off     — 비활성
#   img2img — flux/dev img2img 마감 패스 (~$0.025/장, +5~8초) ← 기본
SNAP_FINISHING_MODE=img2img
#
# SNAP_UPSCALE_MODE: 업스케일 + sharpen
#   off            — 비활성 (기본)
#   aura-sharpen   — aura-sr 2x → sharpen (~$0.015/장, +5초). 얼굴 보존 우수
#   topaz-sharpen  — Topaz 2x → sharpen (~$0.06/장, +8초). 디테일 복원 우수
SNAP_UPSCALE_MODE=off
#
# ── 신부 얼굴 identity 보존 토글 (Phase B / C) ────────────
# SNAP_IDENTITY_MODE: catalog 결과의 face identity 복원 방식
#   off        — 비활성. Phase A multi-image 결과 그대로
#   face-swap  — Phase A 결과 + face swap 후처리. catalog 구도/의상/배경 보존,
#                얼굴만 selfie 진본으로 교체. solo/together 둘 다 작동.
#                추가 비용 ~$0.01~0.04/장. ← 기본 (테스트 결과 채택)
SNAP_IDENTITY_MODE=face-swap
#
# SNAP_IMAGE_QUALITY: 카탈로그 gpt-image-2 quality
#   low    — ~272 토큰, 거친 결과 (-$0.03/장 vs medium)
#   medium — ~1,056 토큰, 인페인팅 충분 ← 기본
#   high   — ~4,160 토큰, 디테일 최대 (+$0.09/장 vs medium). A/B 테스트용
#   auto   — fal 측 자동 결정
# 잘못된 값이면 medium 으로 fallback. snap_jobs.quality 컬럼에 실제 사용값 기록.
SNAP_IMAGE_QUALITY=medium
#
# SNAP_CATALOG_FACE_BLUR: 카탈로그 마스터의 얼굴 영역 사전 blur
#   off — 비활성. 원본 그대로 사용
#   on  — sharp 로 얼굴 영역(catalog.ts 의 faceMaskRegions) 강하게 blur 후
#         fal 에 전달. 모델이 catalog 의 다른 얼굴 특징에 attention 끌려가는
#         것 방지. 추가 비용 0 (sharp 로컬, in-memory 캐시). ← 기본 (테스트 결과 채택)
#   주의: faceMaskRegions 좌표는 카탈로그별로 추정치 — 실제 이미지에 맞춰
#         조정 필요할 수 있음 (catalog.ts).
SNAP_CATALOG_FACE_BLUR=on

# ── Payment (PortOne V2) ─────────────────────────────────
# https://admin.portone.io → 연동 정보
# Store ID와 channel key는 브라우저에 내려감. API secret은 서버 전용.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# ── Base URL ─────────────────────────────────────────────
# 로컬: http://localhost:3000
# 운영: https://<your-domain>
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Cron (자동 정리) ──────────────────────────────────────
# /api/cron/cleanup-drafts 호출 시 Authorization: Bearer <CRON_SECRET>
# 헤더가 일치해야 동작. Vercel Cron 사용 시 자동으로 같은 헤더가 붙는다.
# production에서는 반드시 설정 — 미설정 시 cron 라우트가 500을 반환.
CRON_SECRET=
