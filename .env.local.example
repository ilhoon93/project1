KAKAO_CLIENT_SECRET=4OYlKn4fn5zvtuoDkLcEmwJaRBBnQSmy

# ── Auth (Naver Login) ────────────────────────────────────
# Naver Developers (https://developers.naver.com) → 애플리케이션 등록 → Naver Login
#   Callback URL: <BASE_URL>/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Naver Commerce API (스마트스토어 주문 자동 조회) ───────
# https://apicenter.commerce.naver.com → 애플리케이션 등록
# These are SEPARATE credentials from Naver Login. Optional — if unset,
# /api/orders/register accepts the user's manually entered 상품주문번호
# without server-side verification.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# ── AI (fal.ai) ──────────────────────────────────────────
# Get at https://fal.ai/dashboard/keys
FAL_KEY=

# ── Payment (PortOne V2) ─────────────────────────────────
# Get at https://admin.portone.io  →  연동 정보 메뉴
# Store ID and channel key are exposed to the browser; API secret is server-only.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# ── Base URL ─────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
